  "version": "0.2.0",
  "configurations": [
    {
      "name": "LaunchFisrtAPI",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "FisrtAPIbuild",
      "program": "FirstApi.dll",
      "args": [],
      "cwd": "${workspaceFolder}/FirstApi/bin/Debug/net10.0",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "console": "integratedTerminal",
      "justMyCode": false,
      "launchSettingsProfile": "https",
      "launchSettingsFilePath": "${workspaceFolder}/FirstApi/Properties/launchSettings.json"
    },
    {
      "name": "LaunchSecondAPI",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "SecondAPIbuild",
      "program": "SecApi.dll",
      "args": [],
      "cwd": "${workspaceFolder}/SecApi/bin/Debug/net10.0",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "console": "integratedTerminal",
      "justMyCode": false,
      "launchSettingsProfile": "https",
      "launchSettingsFilePath": "${workspaceFolder}/SecApi/Properties/launchSettings.json"
    }
  ]
}
