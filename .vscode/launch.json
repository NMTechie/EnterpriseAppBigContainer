  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (console)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "CallerOfCommandChain.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/CommandChainingEx/CallerOfCommandChain/bin/Debug/net8.0",
      "stopAtEntry": false,
      "env": {
        // Optional: environment variables
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "console": "internalConsole",
      "justMyCode": true // If true, skips debugging code outside your own projects (SDKs, etc.)
    }
  ]
}
